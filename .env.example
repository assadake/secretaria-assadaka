# Dupliquer ce fichier en .env uniquement pour un lancement local avec Supabase.
# Ne jamais publier .env ni committer les vraies valeurs.
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@<HOST>:5432/postgres?sslmode=require
APP_PASSWORD=change-moi-avec-un-secret-long
SESSION_SECRET=remplace-moi-par-une-cle-aleatoire-longue
